{
  "name": "@ethanli666/qqmail-mcp",
  "version": "2.0.5",
  "type": "module",
  "description": "Connect MCP clients to Tencent's official QQ Mail MCP service",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bugliiiiii/qqmail-mcp.git"
  },
  "homepage": "https://github.com/Bugliiiiii/qqmail-mcp#readme",
  "bin": {
    "qqmail-mcp": "bin/qqmail-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "mcp.json",
    "official-tools.json",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "qqmail",
    "foxmail",
    "oauth",
    "remote-mcp",
    "email"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run check",
    "check": "node --check src/config.js && node --check src/protocol-adapter.js && node --check src/write-confirmation.js && node --check src/upstream-supervisor.js && node --check src/relay-policy.js && node --check bin/qqmail-mcp.js && node --test test/*.test.mjs test/mcp-smoke.mjs",
    "smoke": "node --test test/mcp-smoke.mjs",
    "prepack": "npm run check"
  },
  "dependencies": {
    "mcp-remote": "^0.8.6"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
