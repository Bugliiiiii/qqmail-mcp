{
  "name": "@ethanli666/qqmail-mcp",
  "version": "1.2.2",
  "type": "module",
  "description": "Portable QQ Mail MCP server for reading messages and downloading attachments",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bugliiiiii/qqmail-mcp.git"
  },
  "homepage": "https://github.com/Bugliiiiii/qqmail-mcp#readme",
  "bin": {
    "qqmail-mcp": "bin/qqmail-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "qqmail",
    "foxmail",
    "imap",
    "email"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check src/index.js && node --test test/*.test.mjs",
    "smoke": "node test/mcp-smoke.mjs",
    "prepack": "npm run check && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "imapflow": "1.7.0",
    "mailparser": "3.9.20",
    "zod": "4.3.6"
  }
}
